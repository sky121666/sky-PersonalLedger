{
  "name": "personal-ledger-web",
  "version": "1.0.12",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vue-tsc -b && vue-tsc --noEmit -p tsconfig.test.json && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "verify:brace-depth": "node scripts/verify-brace-pattern-depth.mjs",
    "verify:bundle": "../scripts/check-web-performance-budget.sh",
    "verify:attachments": "node scripts/verify-deferred-attachment-delete.mjs"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "@vue/devtools-api": "8.2.1",
    "@lucide/vue": "1.57.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13",
    "@tailwindcss/vite": "4.3.3"
  }
}
