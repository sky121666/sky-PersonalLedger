# 个人账本环境变量配置
# 复制此文件为 .env 并修改配置值

# 服务器配置
LEDGER_SERVER_PORT=8080
LEDGER_SERVER_MODE=release
LEDGER_SERVER_WEB_PATH=./web/dist
# 仅在反向代理部署时填写代理 IP/CIDR，多个值用逗号分隔；留空不信任转发头。
LEDGER_SERVER_TRUSTED_PROXIES=

# 数据库配置
LEDGER_DATABASE_DRIVER=sqlite
LEDGER_DATABASE_PATH=./data/ledger.db
# PostgreSQL 示例:
# LEDGER_DATABASE_DRIVER=postgres
# LEDGER_DATABASE_DSN=postgres://ledger:password@db:5432/ledger?sslmode=disable&TimeZone=Asia/Shanghai
# MySQL/MariaDB 示例:
# LEDGER_DATABASE_DRIVER=mysql
# LEDGER_DATABASE_DSN=ledger:password@tcp(db:3306)/ledger?charset=utf8mb4&parseTime=True&loc=Local
# LEDGER_DATABASE_MAX_OPEN_CONNS=10
# LEDGER_DATABASE_MAX_IDLE_CONNS=5
LEDGER_SETUP_CONFIG_PATH=./data/config.yaml

# JWT 配置（必填：至少 32 位随机密钥）
# 生成示例: openssl rand -base64 32
LEDGER_JWT_SECRET=

# 首次远程安装令牌（Docker 必填，至少 32 位）
# 生成示例: openssl rand -hex 32
# 初始化 URL: /#/setup?setup_token=<该值>
LEDGER_SETUP_TOKEN=

# 存储配置
LEDGER_STORAGE_UPLOAD_PATH=./data/uploads
LEDGER_STORAGE_BACKUP_PATH=./data/backups
LEDGER_STORAGE_MAX_FILE_SIZE=10
# JSON 备份恢复文件上限（MB），独立于普通附件限制。
LEDGER_STORAGE_RESTORE_MAX_FILE_SIZE=64
LEDGER_STORAGE_ALLOWED_TYPES=jpg,jpeg,png,gif,webp,pdf,doc,docx,xls,xlsx,txt

# 安全配置（可选）
# 取消注释并设置随机路径以启用安全入口保护
# 这将通过要求 URL 中包含密钥路径来防止未授权访问
# 示例：https://your-domain.com/abc123xyz/
# LEDGER_SECURITY_BASE_PATH=/abc123xyz

# 默认阻止 AI、Webhook、SMTP 访问回环/内网/链路本地地址，防止 SSRF。
# 只有确需连接本机 Ollama、内网网关或内网 SMTP 时才显式开启。
LEDGER_SECURITY_ALLOW_PRIVATE_OUTBOUND=false

# CORS 配置（跨域资源共享）
# 留空表示仅允许同站 Host 和无 Origin 请求，适合 Web 与 API 同域部署。
# 前后端分离时设置为具体域名，例如：https://your-domain.com
# 仅开发环境可以使用 *；release 模式会拒绝通配 CORS。
LEDGER_CORS_ALLOWED_ORIGINS=

# 日志配置
LEDGER_LOG_LEVEL=info
LEDGER_LOG_FORMAT=json

# AI Provider 配置
# DeepSeek/OpenAI/SiliconFlow 等 OpenAI-compatible Provider 在登录后的 Web 或移动端「AI 财务报告」页面中保存。
# 不要把 Provider API Key 写入 .env、代码、Docker Compose 或公开文档。
